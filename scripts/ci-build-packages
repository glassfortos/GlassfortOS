#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Build Glassfort packages in a clean chroot and lint them with namcap.
# Meant to run as root inside an archlinux container booted with systemd
# as PID 1 (systemd-nspawn needs it). Never run it on a development
# machine: it creates users and installs packages.
#
# Usage: scripts/ci-build-packages <repo-root> [cache-dir]
#
# Builds components/third-party/* first, then components/*. Packages
# built earlier in the run are installed into the chroot of later builds
# (makechrootpkg -I), because Glassfort packages depend on carried
# third-party packages that are not in the Arch repositories.
#
# If cache-dir is given, third-party packages whose exact file name
# (name-version-release) is already in it are reused instead of rebuilt,
# and newly built ones are stored there. Own components are always built.
# All packages end up in <repo-root>/out/.

set -euo pipefail

if [[ ! -f /etc/arch-release ]] || ((EUID != 0)); then
    echo "This script must run as root inside an Arch Linux container." >&2
    exit 1
fi

root=$(realpath "${1:?usage: $0 <repo-root> [cache-dir]}")
cache=${2:-}

shopt -s nullglob
dirs=()
third_party=()
for pkgbuild in "$root"/components/third-party/*/PKGBUILD; do
    dirs+=("$(dirname "$pkgbuild")")
    third_party+=("$(dirname "$pkgbuild")")
done
for pkgbuild in "$root"/components/*/PKGBUILD; do
    dirs+=("$(dirname "$pkgbuild")")
done

if ((${#dirs[@]} == 0)); then
    echo "No packages to build."
    exit 0
fi

# The archlinux image ships without an initialised keyring and without a
# machine ID; mkarchroot and systemd-nspawn need both.
pacman-key --init
pacman-key --populate archlinux
[[ -s /etc/machine-id ]] || systemd-machine-id-setup

# Full upgrade only - never a partial sync (CLAUDE.md §6.4).
pacman -Syu --noconfirm --needed base-devel devtools namcap sudo

# extra-x86_64-build refuses to run as root.
if ! id builder &>/dev/null; then
    useradd --create-home builder
fi
echo 'builder ALL=(ALL) NOPASSWD: ALL' >/etc/sudoers.d/builder
chmod 0440 /etc/sudoers.d/builder

out="$root/out"
mkdir -p "$out"
[[ -n $cache ]] && mkdir -p "$cache"

# Packages built (or restored) so far; installed into later chroots.
local_pkgs=()
status=0

is_third_party() {
    local d
    for d in "${third_party[@]}"; do
        [[ $d == "$1" ]] && return 0
    done
    return 1
}

for dir in "${dirs[@]}"; do
    name=$(basename "$dir")
    work="/home/builder/build/$name"
    echo "::group::Build $name"
    rm -rf "$work"
    mkdir -p "$(dirname "$work")"
    cp -r "$dir" "$work"
    chown -R builder:builder /home/builder/build

    # Debug packages are listed but not produced in the clean chroot
    # (arch=any, or !debug), so they are not expected.
    mapfile -t expected < <(cd "$work" && sudo -u builder makepkg --packagelist | grep -v -- '-debug-')

    # Reuse cached third-party packages with the same name-version-release.
    if [[ -n $cache ]] && is_third_party "$dir"; then
        hit=1
        for pkg in "${expected[@]}"; do
            [[ -f "$cache/$(basename "$pkg")" ]] || hit=0
        done
        if ((hit)); then
            for pkg in "${expected[@]}"; do
                echo "Reusing cached $(basename "$pkg")"
                cp "$cache/$(basename "$pkg")" "$out/"
                local_pkgs+=("$out/$(basename "$pkg")")
            done
            echo "::endgroup::"
            continue
        fi
    fi

    namcap "$work/PKGBUILD"
    inject=()
    for pkg in "${local_pkgs[@]}"; do
        inject+=(-I "$pkg")
    done
    # Meta packages ("# ci: no-chroot" in the PKGBUILD) have nothing to
    # build; a clean chroot would only download all their dependencies on
    # every run. Build them with makepkg --nodeps instead; namcap still runs.
    if grep -q '^# ci: no-chroot' "$work/PKGBUILD"; then
        build=(sudo -u builder makepkg --nodeps --force --noconfirm)
    else
        build=(sudo -u builder extra-x86_64-build -- "${inject[@]}")
    fi
    if ! (cd "$work" && "${build[@]}"); then
        echo "::error::Build failed: $name"
        status=1
        echo "::endgroup::"
        continue
    fi

    for pkg in "${expected[@]}"; do
        namcap "$pkg"
        cp "$pkg" "$out/"
        local_pkgs+=("$out/$(basename "$pkg")")
        if [[ -n $cache ]] && is_third_party "$dir"; then
            cp "$pkg" "$cache/"
        fi
    done
    echo "::endgroup::"
done

exit "$status"
