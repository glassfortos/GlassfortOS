def gtk_colors(p: Palette) -> dict[str, RGB]:
    """adw-gtk3 named colours that the Glassfort GTK theme overrides.

    Status colours (destructive, success, warning, error) keep adw-gtk3's
    values; adw-gtk3 tunes them for its own surfaces.
    """
    raised = p.button if p.dark else p.view  # cards, dialogs, popovers
    return {
        "accent_bg_color": p.accent,
        "accent_fg_color": p.accent_text,
        "accent_color": p.accent,
        "window_bg_color": p.window,
        "window_fg_color": p.text,
        "view_bg_color": p.view,
        "view_fg_color": p.text,
        "headerbar_bg_color": p.header,
        "headerbar_fg_color": p.text,
        "headerbar_backdrop_color": p.window,
        "sidebar_bg_color": p.window_alt,
        "sidebar_fg_color": p.text,
        "sidebar_backdrop_color": p.window,
        "card_bg_color": raised,
        "card_fg_color": p.text,
        "dialog_bg_color": p.window if not p.dark else raised,
        "dialog_fg_color": p.text,
        "popover_bg_color": raised,
        "popover_fg_color": p.text,
        "thumbnail_bg_color": raised,
        "thumbnail_fg_color": p.text,
    }


def build_gtk_css(p: Palette, gtk: int) -> str:
    base = "gtk-dark.css" if p.dark else "gtk.css"
    lines = [
        "/* SPDX-License-Identifier: GPL-3.0-or-later */",
        "/* Generated by components/glassfort-theme/generate. Do not edit. */",
        "",
        "/* adw-gtk3 (LGPL-2.1, package adw-gtk-theme) with Glassfort colours. */",
        f'@import url("../../adw-gtk3/gtk-{gtk}.0/{base}");',
        "",
    ]
    lines += [f"@define-color {k} {hexc(v)};" for k, v in gtk_colors(p).items()]
    return "\n".join(lines) + "\n"


def check_gtk_contrast(p: Palette) -> list[str]:
    c = gtk_colors(p)
    errors = []
    for fg, bg, need in (
        ("accent_fg_color", "accent_bg_color", 4.5),
        ("accent_color", "window_bg_color", 4.5),
        ("accent_color", "view_bg_color", 4.5),
        ("window_fg_color", "window_bg_color", 4.5),
        ("view_fg_color", "view_bg_color", 4.5),
        ("headerbar_fg_color", "headerbar_bg_color", 4.5),
        ("sidebar_fg_color", "sidebar_bg_color", 4.5),
        ("popover_fg_color", "popover_bg_color", 4.5),
    ):
        r = contrast(c[fg], c[bg])
        if r < need:
            errors.append(f"{p.name}: GTK {fg} on {bg} contrast {r:.2f} < {need}")
    return errors


