# glassfort-theme: Glassfort look (colour schemes, kitty, Kvantum, GTK,
# wallpapers, Global Theme). See README.md and
# docs/03-desktop-design.md. Dependencies: D-34 in docs/DECISIONS.md.

pkgname=glassfort-theme
pkgver=0.1.0
pkgrel=1
pkgdesc='Glassfort global theme, colour schemes, application themes and wallpaper'
arch=('any')
url='https://github.com/glassfortos/GlassfortOS'
license=('GPL-3.0-or-later' 'CC-BY-SA-4.0')  # code / wallpapers
depends=(
    'adw-gtk-theme'
    'inter-font'
    'kvantum'
    'ttf-jetbrains-mono'
    # KSplash screen (Splash.qml): QtQuick, org.kde.kirigami
    'qt6-declarative'
    'kirigami'
)
makedepends=('librsvg')
backup=(
    'etc/gtk-3.0/settings.ini'
    'etc/gtk-4.0/settings.ini'
    'etc/skel/.config/gtk-3.0/settings.ini'
    'etc/skel/.config/gtk-4.0/settings.ini'
    'etc/xdg/Kvantum/kvantum.kvconfig'
    'etc/xdg/kdeglobals'
    'etc/xdg/kscreenlockerrc'
    'etc/xdg/kitty/kitty.conf'
)
source=(
    'GlassfortDark.colors'
    'GlassfortLight.colors'
    'kitty-glassfort-dark.conf'
    'kitty-glassfort-light.conf'
    'kitty.conf'
    # Generated by ./generate from the colour schemes.
    'kvantum-Glassfort.kvconfig'
    'kvantum-Glassfort.svg'
    'kvantum-GlassfortDark.kvconfig'
    'kvantum-GlassfortDark.svg'
    'gtk3-gtk.css'
    'gtk3-gtk-dark.css'
    'gtk4-gtk.css'
    'gtk4-gtk-dark.css'
    'wallpaper-light.svg'
    'wallpaper-dark.svg'
    # Hand-written.
    'gtk-index.theme'
    'gtk-settings.ini'
    'wallpaper-metadata.json'
    'lnf-light-metadata.json'
    'lnf-light-defaults'
    'lnf-dark-metadata.json'
    'lnf-dark-defaults'
    'xdg-kdeglobals'
    'xdg-kvantum.kvconfig'
    'xdg-kscreenlockerrc'
    'lnf-splash.qml'
)
