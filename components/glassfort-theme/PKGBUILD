# Wallpaper sizes: 16:9 in 4K and Full HD; Plasma picks the closest one.
_wallpaper_sizes=('3840x2160' '1920x1080')

build() {
    cd "${srcdir}"
    local variant size
    for variant in light dark; do
        for size in "${_wallpaper_sizes[@]}"; do
            rsvg-convert -w "${size%x*}" -h "${size#*x}" -o "wallpaper-${variant}-${size}.png" "wallpaper-${variant}.svg"
        done
        # Preview for System Settings > Global Theme.
        rsvg-convert -w 600 -h 337 -o "lnf-${variant}-preview.png" "wallpaper-${variant}.svg"
    done
}

package() {
    cd "${srcdir}"
    install -Dm644 -t "${pkgdir}/usr/share/color-schemes" GlassfortDark.colors GlassfortLight.colors

    install -Dm644 kitty-glassfort-dark.conf "${pkgdir}/usr/share/glassfort/kitty/glassfort-dark.conf"
    install -Dm644 kitty-glassfort-light.conf "${pkgdir}/usr/share/glassfort/kitty/glassfort-light.conf"
    install -Dm644 kitty.conf "${pkgdir}/etc/xdg/kitty/kitty.conf"
    # kitty 0.38+ switches between these with the desktop colour scheme.
    ln -s /usr/share/glassfort/kitty/glassfort-dark.conf "${pkgdir}/etc/xdg/kitty/dark-theme.auto.conf"
    ln -s /usr/share/glassfort/kitty/glassfort-light.conf "${pkgdir}/etc/xdg/kitty/light-theme.auto.conf"

    # Widget style "kvantum" uses Glassfort, "kvantum-dark" GlassfortDark.
    local f
    for f in Glassfort.kvconfig Glassfort.svg GlassfortDark.kvconfig GlassfortDark.svg; do
        install -Dm644 "kvantum-${f}" "${pkgdir}/usr/share/Kvantum/Glassfort/${f}"
    done

    # GTK theme "Glassfort": adw-gtk3 plus the Glassfort accent and surfaces.
    local theme="${pkgdir}/usr/share/themes/Glassfort"
    install -Dm644 gtk-index.theme "${theme}/index.theme"
    local v
    for v in 3 4; do
        install -Dm644 "gtk${v}-gtk.css" "${theme}/gtk-${v}.0/gtk.css"
        install -Dm644 "gtk${v}-gtk-dark.css" "${theme}/gtk-${v}.0/gtk-dark.css"
        install -Dm644 gtk-settings.ini "${pkgdir}/etc/gtk-${v}.0/settings.ini"
        install -Dm644 gtk-settings.ini "${pkgdir}/etc/skel/.config/gtk-${v}.0/settings.ini"
    done

    # Plasma wallpaper package; images_dark is used with dark colour schemes.
    local wp="${pkgdir}/usr/share/wallpapers/Glassfort"
    install -Dm644 wallpaper-metadata.json "${wp}/metadata.json"
    local size variant
    for size in "${_wallpaper_sizes[@]}"; do
        install -Dm644 "wallpaper-light-${size}.png" "${wp}/contents/images/${size}.png"
        install -Dm644 "wallpaper-dark-${size}.png" "${wp}/contents/images_dark/${size}.png"
    done

    # Global themes (light and dark) and the system-wide defaults that select
    # them and switch between them by time of day.
    local lnf id
    for variant in light dark; do
        id=org.glassfort.desktop
        [[ ${variant} == dark ]] && id=org.glassfort.dark.desktop
        lnf="${pkgdir}/usr/share/plasma/look-and-feel/${id}"
        install -Dm644 "lnf-${variant}-metadata.json" "${lnf}/metadata.json"
        install -Dm644 "lnf-${variant}-defaults" "${lnf}/contents/defaults"
        install -Dm644 "lnf-${variant}-preview.png" "${lnf}/contents/previews/preview.png"
    done
    # Start splash between login and desktop (KSplash); both themes use it.
    install -Dm644 lnf-splash.qml \
        "${pkgdir}/usr/share/plasma/look-and-feel/org.glassfort.desktop/contents/splash/Splash.qml"
    install -Dm644 xdg-kdeglobals "${pkgdir}/etc/xdg/kdeglobals"
    install -Dm644 xdg-kvantum.kvconfig "${pkgdir}/etc/xdg/Kvantum/kvantum.kvconfig"
    # Lock screen wallpaper.
    install -Dm644 xdg-kscreenlockerrc "${pkgdir}/etc/xdg/kscreenlockerrc"
}
