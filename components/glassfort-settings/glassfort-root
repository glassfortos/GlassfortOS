# Glassfort snapper template for the root subvolume (docs/02-system.md).
# Used by: snapper -c root create-config -t glassfort-root /
# SUBVOLUME and FSTYPE are filled in by snapper.

SUBVOLUME="/"
FSTYPE="btrfs"
QGROUP=""

# Keep snapshots below half of the filesystem and at least 20 % free.
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"

# Administrators can list snapshots without root (Time Machine).
ALLOW_USERS=""
ALLOW_GROUPS="wheel"
SYNC_ACL="yes"

BACKGROUND_COMPARISON="yes"

# Cleanup by number: about 20 pre/post pairs from snap-pac, plus up to
# 10 snapshots marked important ("pinned", snapper modify --important=yes).
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="1800"
NUMBER_LIMIT="40"
NUMBER_LIMIT_IMPORTANT="10"

# No timeline snapshots for the system.
TIMELINE_CREATE="no"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="1800"
TIMELINE_LIMIT_HOURLY="0"
TIMELINE_LIMIT_DAILY="0"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"

# Drop pre/post pairs that changed nothing.
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="1800"
