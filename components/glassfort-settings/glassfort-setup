#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# glassfort-setup – apply Glassfort system defaults on an existing Arch
# install. Idempotent: every step checks first and only changes what is
# missing. Called by the glassfort-settings package after install and
# upgrade; can be run again at any time.
#
# Usage: glassfort-setup [--check]
#   --check   only report what would change, change nothing
#
# Requirements (Phase 1): UEFI, Btrfs root, Limine as bootloader
# (for example archinstall with the Btrfs layout and Limine). Steps whose
# requirements are missing are skipped with a warning; nothing is
# partitioned, formatted or reinstalled.

set -euo pipefail

readonly LSM="landlock,lockdown,yama,integrity,apparmor,bpf"
readonly SNAPPER_TEMPLATE="glassfort-root"
readonly FIREWALL_ZONE="glassfort-public"
# Every Glassfort package may ship a 50-glassfort*.preset (e.g. glassfort-desktop).
readonly PRESET_DIR="/usr/lib/systemd/system-preset"

check_only=0
changed=0
warnings=0

info() { printf '==> %s\n' "$*"; }
step() { printf '  -> %s\n' "$*"; }
warn() {
    printf '==> WARNING: %s\n' "$*" >&2
    warnings=$((warnings + 1))
}

# Run a command, or only print it in --check mode.
apply() {
    changed=$((changed + 1))
    if ((check_only)); then
        step "would run: $*"
    else
        step "$*"
        "$@"
    fi
}

usage() {
    sed -n '4,16s/^# \{0,1\}//p' "$0"
}

for arg in "$@"; do
    case $arg in
    --check) check_only=1 ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
done

if ((EUID != 0)) && ((!check_only)); then
    echo "glassfort-setup must run as root (or use --check)." >&2
    exit 1
fi

# Inside a chroot (installer, package build environment) /proc/cmdline
# belongs to the installer's kernel, not to the system being set up.
in_chroot=0
if command -v systemd-detect-virt &>/dev/null && systemd-detect-virt --chroot &>/dev/null; then
    in_chroot=1
fi

is_uefi=0
[[ -d /sys/firmware/efi ]] && is_uefi=1

root_is_btrfs=0
[[ $(findmnt -no FSTYPE / 2>/dev/null) == btrfs ]] && root_is_btrfs=1

find_limine_conf() {
    local dir
    for dir in /boot /efi /boot/efi; do
        for conf in "$dir/limine.conf" "$dir/EFI/limine/limine.conf" "$dir/limine/limine.conf"; do
            if [[ -f $conf ]]; then
                echo "$conf"
                return 0
            fi
        done
    done
    return 1
}

limine_conf=$(find_limine_conf || true)

# --- 1. Snapper root config ----------------------------------------------

setup_snapper() {
    info "Snapshots (snapper)"
    if ((!root_is_btrfs)); then
        warn "/ is not Btrfs – snapshots are not available. Skipping."
        return
    fi
    if [[ -f /etc/snapper/configs/root ]]; then
        step "snapper config 'root' exists"
        return
    fi

    # A separate @snapshots subvolume mounted at /.snapshots (archinstall
    # layout) makes "snapper create-config" fail, because it wants to
    # create /.snapshots itself. Standard procedure: unmount, let snapper
    # create its config, replace snapper's nested subvolume with the
    # mount point again.
    if mountpoint -q /.snapshots; then
        apply umount /.snapshots
        apply rmdir /.snapshots
        apply snapper --no-dbus -c root create-config -t "$SNAPPER_TEMPLATE" /
        apply btrfs subvolume delete /.snapshots
        apply mkdir /.snapshots
        apply mount /.snapshots
    else
        apply snapper --no-dbus -c root create-config -t "$SNAPPER_TEMPLATE" /
    fi
    apply chmod 750 /.snapshots
    apply chown :wheel /.snapshots
}

# --- 2. Kernel command line (AppArmor) -------------------------------------

# limine-entry-tool reads the kernel command line from KERNEL_CMDLINE in
# /etc/default/limine, then /etc/kernel/cmdline, then /proc/cmdline.
# Kernel command line of the installed system, for use in a chroot: the
# first "cmdline:" of the Limine config the installer wrote (it knows about
# encryption and the like), else built from the root filesystem.
target_cmdline() {
    local conf line uuid subvol
    for conf in /boot/limine.conf /boot/limine/limine.conf /boot/EFI/limine/limine.conf /boot/EFI/BOOT/limine.conf; do
        [[ -f $conf ]] || continue
        line=$(grep -m1 -E '^[[:space:]]*(cmdline|kernel_cmdline):' "$conf" | sed -E 's/^[[:space:]]*[a-z_]+:[[:space:]]*//')
        if [[ $line == *root=* ]]; then
            printf '%s\n' "$line"
            return 0
        fi
    done
    uuid=$(findmnt -no UUID /) || return 1
    [[ -n $uuid ]] || return 1
    subvol=$(findmnt -no OPTIONS / | tr ',' '\n' | sed -n 's/^subvol=//p' | sed 's|^/||')
    printf 'root=UUID=%s rw%s\n' "$uuid" "${subvol:+ rootflags=subvol=$subvol}"
}

setup_cmdline() {
    info "Kernel command line (AppArmor)"
    local file=""
    if [[ -f /etc/default/limine ]] && grep -q '^KERNEL_CMDLINE\[default\]' /etc/default/limine; then
        file=/etc/default/limine
    elif [[ -s /etc/kernel/cmdline ]]; then
        file=/etc/kernel/cmdline
    fi

    if [[ -n $file ]] && grep -q "lsm=$LSM" "$file"; then
        step "lsm=$LSM already set in $file"
        return
    fi
    if [[ -n $file ]] && grep -q 'lsm=' "$file"; then
        warn "$file sets a different lsm= value. Not changing it; Glassfort expects lsm=$LSM."
        return
    fi

    case $file in
    /etc/default/limine)
        apply sed -i "s|^\(KERNEL_CMDLINE\[default\]+\{0,1\}=.*\)$|\1 lsm=$LSM|" "$file"
        ;;
    /etc/kernel/cmdline)
        apply sed -i "1s|\$| lsm=$LSM|" "$file"
        ;;
    *)
        # Create /etc/kernel/cmdline without the parts that limine-entry-tool
        # adds itself.
        local cmdline
        if ((in_chroot)); then
            # /proc/cmdline belongs to the installer's kernel here (e.g. the
            # Arch ISO), not to the system being set up.
            cmdline=$(target_cmdline) || {
                warn "Cannot tell the installed system's kernel command line; not writing /etc/kernel/cmdline."
                return
            }
        else
            if [[ $(findmnt -no FSTYPE / 2>/dev/null) == overlay ]] || grep -q 'subvol=[^ ]*snapshots' /proc/cmdline; then
                warn "Running from a snapshot – not deriving the command line from it."
                return
            fi
            cmdline=$(</proc/cmdline)
        fi
        cmdline=$(tr ' ' '\n' <<<"$cmdline" | grep -vE '^(BOOT_IMAGE|initrd)=' | grep -v '^lsm=' | grep -v '^$' | tr '\n' ' ')
        cmdline="${cmdline% } lsm=$LSM"
        changed=$((changed + 1))
        if ((check_only)); then
            step "would write /etc/kernel/cmdline: $cmdline"
        else
            step "write /etc/kernel/cmdline: $cmdline"
            mkdir -p /etc/kernel
            printf '%s\n' "$cmdline" >/etc/kernel/cmdline
        fi
        ;;
    esac
}

# --- 3. initramfs hook for booting read-only snapshots ---------------------

setup_mkinitcpio() {
    info "initramfs (boot into snapshots)"
    local conf=/etc/mkinitcpio.conf
    if [[ ! -f $conf ]]; then
        warn "$conf not found. Skipping."
        return
    fi
    local hooks
    hooks=$(grep -E '^HOOKS=' "$conf" | tail -n1)
    if [[ $hooks =~ (^|[\ \(])(sd-)?btrfs-overlayfs([\ \)]|$) ]]; then
        step "overlayfs hook already present"
        return
    fi
    local hook=btrfs-overlayfs
    [[ $hooks =~ (^|[\ \(])systemd([\ \)]|$) ]] && hook=sd-btrfs-overlayfs
    if [[ ! $hooks =~ (^|[\ \(])filesystems([\ \)]|$) ]]; then
        warn "No 'filesystems' hook in $conf. Add '$hook' after it manually."
        return
    fi
    apply sed -i -E "/^HOOKS=/s/(^|[ (])filesystems([ )])/\1filesystems $hook\2/" "$conf"
}

# --- 3b. Boot splash (Plymouth, D-41) --------------------------------------------

# Plymouth comes with glassfort-desktop and the theme with glassfort-branding.
# Without them (e.g. a server with only glassfort-settings) nothing changes.
setup_splash() {
    info "Boot splash (Plymouth)"
    if ! command -v plymouth-set-default-theme &>/dev/null || [[ ! -d /usr/share/plymouth/themes/glassfort ]]; then
        step "plymouth or the Glassfort theme not installed – skipped"
        return
    fi

    # initramfs: the plymouth hook right after udev/systemd, before any
    # encryption hook, so the passphrase prompt shows in the splash.
    local conf=/etc/mkinitcpio.conf hooks
    hooks=$(grep -E '^HOOKS=' "$conf" | tail -n1)
    if [[ $hooks =~ (^|[\ \(])plymouth([\ \)]|$) ]]; then
        step "plymouth hook already present"
    elif [[ $hooks =~ (^|[\ \(])(systemd|udev)([\ \)]|$) ]]; then
        apply sed -i -E "/^HOOKS=/s/(^|[ (])(systemd|udev)([ )])/\1\2 plymouth\3/" "$conf"
    else
        warn "No 'systemd' or 'udev' hook in $conf. Add 'plymouth' after it manually."
    fi

    # Kernel command line: quiet splash (same file the AppArmor step uses).
    local file=""
    if [[ -f /etc/default/limine ]] && grep -q '^KERNEL_CMDLINE\[default\]' /etc/default/limine; then
        file=/etc/default/limine
    elif [[ -s /etc/kernel/cmdline ]]; then
        file=/etc/kernel/cmdline
    fi
    if [[ -z $file ]]; then
        warn "No kernel command line file to add 'quiet splash' to."
    else
        local word
        for word in quiet splash; do
            if grep -qE "(^|[ \"])$word([ \"]|$)" "$file"; then
                step "$word already set in $file"
            elif [[ $file == /etc/default/limine ]]; then
                apply sed -i "s|^\(KERNEL_CMDLINE\[default\]+\{0,1\}=.*\)\(\"\)$|\1 $word\2|; t; s|^\(KERNEL_CMDLINE\[default\]+\{0,1\}=.*\)$|\1 $word|" "$file"
            else
                apply sed -i "1s|\$| $word|" "$file"
            fi
        done
    fi

    # Theme (plymouth-set-default-theme writes /etc/plymouth/plymouthd.conf;
    # limine-update rebuilds the initramfs afterwards).
    if [[ $(plymouth-set-default-theme) == glassfort ]]; then
        step "Plymouth theme is glassfort"
    else
        apply plymouth-set-default-theme glassfort
    fi
}

# --- 4. Firewall -------------------------------------------------------------

setup_firewall() {
    info "Firewall"
    local current
    current=$(firewall-offline-cmd --get-default-zone 2>/dev/null || true)
    if [[ $current == "$FIREWALL_ZONE" ]]; then
        step "default zone is $FIREWALL_ZONE"
        return
    fi
    apply firewall-offline-cmd --set-default-zone="$FIREWALL_ZONE"
}

# --- 5. Services ---------------------------------------------------------------

setup_services() {
    info "Services"
    local presets=("$PRESET_DIR"/50-glassfort*.preset)
    if [[ ! -f ${presets[0]} ]]; then
        warn "No $PRESET_DIR/50-glassfort*.preset found (glassfort-settings not installed?). Skipping."
        return
    fi
    local action unit
    while read -r action unit; do
        [[ $action == enable ]] || continue
        if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
            step "$unit enabled"
        elif ! apply systemctl enable "$unit"; then
            # E.g. sddm while another login manager owns display-manager.service.
            warn "Could not enable $unit; enable it by hand if you want it."
        fi
    done < <(grep -hE '^(enable|disable)[[:space:]]' "${presets[@]}")
}

# --- 6. Boot entries -------------------------------------------------------------

# Installers (e.g. archinstall) write a plain entry such as "/Arch Linux
# (linux)" that boots /vmlinuz-linux directly. Once limine-entry-tool's
# managed entry ("/+...") exists, that old entry would still be the default
# (Limine boots the first entry) – without Glassfort's kernel command line
# and away from the snapshot menu. Comment such entries out, with a backup.
disable_installer_entries() {
    local conf=$1
    grep -q '^/+' "$conf" || return 0
    local plan
    plan=$(awk '
        /^\/[^\/+]/ { block = NR; name[NR] = $0; direct[NR] = 0 }
        /^\/\/|^\/\+/ { block = 0 }
        block && /^[[:space:]]*(path|kernel_path):[[:space:]]*boot\(\):\/vmlinuz-/ { direct[block] = 1 }
        END { for (b in direct) if (direct[b]) print b ":" name[b] }
    ' "$conf")
    [[ -n $plan ]] || return 0
    local line
    while IFS= read -r line; do
        step "disable installer entry ${line#*:} (Glassfort's entry boots the same kernel)"
    done <<<"$plan"
    changed=$((changed + 1))
    ((check_only)) && return 0
    cp -p "$conf" "$conf.glassfort-bak"
    awk -v starts="$(cut -d: -f1 <<<"$plan" | tr '\n' ' ')" '
        BEGIN { n = split(starts, a, " "); for (i = 1; i <= n; i++) start[a[i]] = 1 }
        start[NR] { off = 1 }
        off && NR > 1 && !start[NR] && /^\// { off = 0 }
        { print (off ? "#" $0 : $0) }
    ' "$conf.glassfort-bak" >"$conf"
    step "backup: $conf.glassfort-bak"
}

# Limine numbers every entry in order, directories included, and boots
# default_entry (1 if unset) after the timeout. limine-entry-tool's managed
# entry is a directory ("/+Arch Linux"), which cannot boot, so the menu
# would wait forever. Point default_entry at its first kernel.
set_default_entry() {
    local conf=$1
    grep -q '^/+' "$conf" || return 0
    local want have
    want=$(awk '
        /^[[:space:]]*#/ { next }
        /^[[:space:]]*\// { n++ }
        /^\/\+/ { inside = 1; next }
        inside && /^[[:space:]]*\/\/[^\/]/ { print n; exit }
        inside && /^\/[^\/+]/ { inside = 0 }
    ' "$conf")
    [[ -n $want ]] || return 0
    have=$(sed -n 's/^default_entry:[[:space:]]*//p' "$conf" | head -1)
    if [[ $have == "$want" ]]; then
        step "default boot entry is $want (Glassfort's kernel)"
        return 0
    fi
    changed=$((changed + 1))
    if ((check_only)); then
        step "would set default_entry: $want in $conf"
        return 0
    fi
    [[ -f $conf.glassfort-bak ]] || cp -p "$conf" "$conf.glassfort-bak"
    if [[ -n $have ]]; then
        sed -i "s/^default_entry:.*/default_entry: $want/" "$conf"
    else
        # Global options go before the first entry.
        awk -v want="$want" '
            !done && /^[[:space:]]*\// { print "default_entry: " want; done = 1 }
            { print }
        ' "$conf" >"$conf.glassfort-tmp" && cat "$conf.glassfort-tmp" >"$conf" && rm -f "$conf.glassfort-tmp"
    fi
    step "set default_entry: $want in $conf (Glassfort's kernel)"
}

setup_boot_entries() {
    info "Boot menu (Limine)"
    if ((!is_uefi)); then
        warn "Not booted in UEFI mode. Glassfort needs UEFI; skipping boot setup."
        return
    fi
    if [[ -z $limine_conf ]]; then
        warn "No limine.conf found on the ESP – Limine is not the bootloader. Install Arch with Limine (for example archinstall) to get snapshot boot entries."
        return
    fi
    if ((changed == 0)); then
        step "nothing changed, boot entries are current ($limine_conf)"
    else
        apply limine-update
    fi
    # limine-update creates the managed entry on first setup; afterwards the
    # installer's entry can go. Changing limine.conf needs another
    # limine-update (it re-enrolls the config checksum when that is used).
    local before=$changed
    disable_installer_entries "$limine_conf"
    set_default_entry "$limine_conf"
    if ((changed > before)); then
        apply limine-update
    fi
}

setup_snapper
setup_cmdline
setup_mkinitcpio
setup_splash
setup_firewall
setup_services
setup_boot_entries

if ((check_only)); then
    info "Check finished: $changed change(s) needed, $warnings warning(s)."
else
    info "Glassfort setup finished: $changed change(s), $warnings warning(s)."
fi
