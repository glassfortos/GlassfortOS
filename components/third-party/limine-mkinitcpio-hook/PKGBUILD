# Maintainer: Glassfort project <https://github.com/jankln/GlassfortOS>
# Contributor: Zesko (upstream author and AUR maintainer)
#
# Carried in [glassfort] because it is AUR-only (CLAUDE.md §6.6).
# Based on the AUR PKGBUILD of limine-mkinitcpio-hook 1.41.0-1.
# Glassfort changes: see README.md.

_pkgname=limine-entry-tool
pkgname=limine-mkinitcpio-hook
pkgver=1.41.0
pkgrel=1
pkgdesc='Install kernels for the Limine bootloader (mkinitcpio integration)'
arch=('x86_64')
url='https://gitlab.com/Zesko/limine-entry-tool'
license=('GPL-3.0-only')
depends=(
    'bash'
    'glibc'
    'zlib'
    'grep'
    'tar'
    'limine'
    'mkinitcpio'
    'efibootmgr'
)
makedepends=('git' 'gradle')
optdepends=('sbctl: sign the Limine EFI binary for Secure Boot')
provides=('limine-entry-tool')
conflicts=('limine-entry-tool')
backup=('etc/limine-entry-tool.conf')
options=(!debug !strip)
_graalvm=graalvm-community-jdk-25i2-25.0.4_linux-x64_bin.tar.gz
# Tag 1.41.0 = commit 5e6be0cf978edc511786fddd662d1f50280eafad
source=(
    "${_pkgname}::git+${url}.git#tag=${pkgver}"
    "https://github.com/graalvm/graalvm-ce-builds/releases/download/graal-25.2.4/${_graalvm}"
    'logger-no-shell.patch'
)
sha256sums=('77ffb5a030b379a3385c703e922d84acfc959cc4e8a8ead0f585d9ba15550496'
            '3f4a89de8eaa96f2ed677f09957c7e872cd8467aad3537f8b5394c1b8c4b942e'
            '22e909909889eef3cac0025748fcb0a1f06a1c50aab9a9ccceaa01c12dbeee7a')

prepare() {
    rm -rf graalvm
    mv graalvm-community-*/ graalvm
    patch -d "${_pkgname}" -p1 <logger-no-shell.patch
}

build() {
    cd "${_pkgname}"
    export GRAALVM_HOME="${srcdir}/graalvm"
    export JAVA_HOME="${GRAALVM_HOME}"
    export NATIVE_IMAGE_OPTIONS='-march=compatibility --future-defaults=all'
    gradle --no-daemon clean nativeCompile -Dorg.gradle.java.home="${JAVA_HOME}"
}

package() {
    cd "${_pkgname}"
    local src=install/arch-linux

    install -dm755 \
        "${pkgdir}/etc/boot/hooks/pre.d" \
        "${pkgdir}/etc/boot/hooks/post.d" \
        "${pkgdir}/usr/lib/limine"
    install -Dm644 README.md CHANGELOG.md -t "${pkgdir}/usr/share/doc/${_pkgname}/"

    cp -a "${src}/limine-entry-tool/etc" "${src}/limine-entry-tool/usr" "${pkgdir}/"
    cp -a "${src}/limine-mkinitcpio-hook/etc" "${src}/limine-mkinitcpio-hook/usr" "${pkgdir}/"
    install -Dm755 build/native/nativeCompile/limine-entry-tool -t "${pkgdir}/usr/lib/limine/"

    # Glassfort: drop the interactive /usr/local/bin/mkinitcpio wrapper.
    # Packages must not install into /usr/local, and an interactive prompt
    # can hang non-interactive callers (update app, assistant helper).
    rm -rf "${pkgdir:?}/usr/local"

    ln -sf /usr/bin/limine-reset-enroll "${pkgdir}/etc/boot/hooks/pre.d/10-limine-reset-enroll"
    ln -sf /usr/bin/limine-enroll-config "${pkgdir}/etc/boot/hooks/post.d/90-limine-enroll-config"
}
