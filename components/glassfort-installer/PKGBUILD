build() {
    local po lang
    for po in "${srcdir}"/glassfort-installer-*.po; do
        lang=${po##*/glassfort-installer-}
        lang=${lang%.po}
        msgfmt --check -o "${srcdir}/glassfort-installer-${lang}.mo" "${po}"
    done
}

check() {
    cd "${srcdir}"
    python -m pytest -q -p no:cacheprovider test_install.py test_installer_data.py
}

package() {
    install -Dm644 "${srcdir}/glassfort_install.py" \
        "${pkgdir}/usr/lib/glassfort-installer/glassfort_install.py"
    install -Dm755 "${srcdir}/glassfort-install" "${pkgdir}/usr/bin/glassfort-install"

    install -Dm644 -t "${pkgdir}/usr/lib/glassfort-installer" \
        "${srcdir}/installer_data.py" "${srcdir}/installer_ui.py"
    install -Dm755 "${srcdir}/glassfort-installer" "${pkgdir}/usr/bin/glassfort-installer"
    install -Dm644 "${srcdir}/org.glassfort.installer.desktop" \
        "${pkgdir}/usr/share/applications/org.glassfort.installer.desktop"
    local mo lang
    for mo in "${srcdir}"/glassfort-installer-*.mo; do
        lang=${mo##*/glassfort-installer-}
        lang=${lang%.mo}
        install -Dm644 "${mo}" "${pkgdir}/usr/share/locale/${lang}/LC_MESSAGES/glassfort-installer.mo"
    done
    local f
    for f in Main.qml LanguagePage.qml NetworkPage.qml DiskPage.qml UserPage.qml LookPage.qml ProgressPage.qml DonePage.qml; do
        install -Dm644 "${srcdir}/${f}" "${pkgdir}/usr/share/glassfort-installer/qml/${f}"
    done
}
