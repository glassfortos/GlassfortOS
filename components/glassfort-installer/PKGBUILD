# glassfort-installer: installs Glassfort from the live medium.
# See README.md and docs/04-installer.md.

pkgname=glassfort-installer
pkgver=0.1.0
pkgrel=1
pkgdesc='Glassfort installer (QML/Kirigami UI, backend on top of archinstall)'
arch=('any')
url='https://github.com/glassfortos/GlassfortOS'
license=('GPL-3.0-or-later')
depends=(
    'python'
    'archinstall'
    'arch-install-scripts'
    'btrfs-progs'
    'cryptsetup'
    'e2fsprogs'
    'systemd'
    'util-linux'
    # UI
    'kconfig'
    'kirigami'
    'networkmanager'
    'pyside6'
    'qt6-declarative'
    'sudo'
)
checkdepends=('python-pytest')
source=(
    'glassfort_install.py'
    'glassfort-install'
    'installer_data.py'
    'installer_ui.py'
    'glassfort-installer'
    'org.glassfort.installer.desktop'
    'Main.qml'
    'LanguagePage.qml'
    'NetworkPage.qml'
    'DiskPage.qml'
    'UserPage.qml'
    'LookPage.qml'
    'ProgressPage.qml'
    'DonePage.qml'
    'test_install.py'
    'test_installer_data.py'
)
