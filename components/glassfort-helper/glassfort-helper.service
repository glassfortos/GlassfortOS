# Started on demand through D-Bus activation; exits when idle.
[Unit]
Description=Glassfort privileged helper

[Service]
Type=dbus
BusName=org.glassfort.Helper1
ExecStart=/usr/lib/glassfort-helper/glassfort-helper
# A restore must not be cut short by a stop request.
TimeoutStopSec=16min
KillMode=mixed
# The restore changes Btrfs subvolumes and /boot, so the file system cannot
# be made read-only here; keep what does not get in its way.
NoNewPrivileges=yes
PrivateTmp=no
ProtectHome=read-only
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
