<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Glassfort</vendor>
  <vendor_url>https://github.com/glassfortos/GlassfortOS</vendor_url>
  <icon_name>glassfort</icon_name>

  <action id="org.glassfort.helper.restore-snapshot">
    <description>Restore an earlier state of the system</description>
    <description xml:lang="de">Einen früheren Zustand des Systems wiederherstellen</description>
    <message>Authentication is required to restore an earlier state of the system.</message>
    <message xml:lang="de">Zum Wiederherstellen eines früheren Systemzustands ist eine Authentifizierung erforderlich.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
