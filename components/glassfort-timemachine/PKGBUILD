# glassfort-timemachine: the "Restore Points" module in System Settings
# (docs/02, D-44, D-45).

pkgname=glassfort-timemachine
pkgver=0.1.0
pkgrel=1
pkgdesc='Glassfort Restore Points: snapshot timeline, pin and restore in System Settings'
arch=('x86_64')
url='https://github.com/glassfortos/GlassfortOS'
license=('GPL-3.0-or-later')
depends=(
    'gcc-libs'
    'glibc'
    'qt6-base'
    'qt6-declarative'
    'kcoreaddons'
    'ki18n'
    'kcmutils'
    'kirigami'
    'snapper'
    'glassfort-helper'
    # glassfort-restore-notify
    'bash'
    'gettext'
    'libnotify'
    'systemsettings'
)
makedepends=('cmake' 'extra-cmake-modules' 'gettext')
source=(
    'CMakeLists.txt'
    'kcm_glassfort_timemachine.json'
    'main.qml'
    'restorepoints.cpp'
    'restorepoints.h'
    'snapshotmodel.cpp'
    'snapshotmodel.h'
    'snapshotmodeltest.cpp'
    'glassfort-restore-notify'
    'org.glassfort.restore-notify.desktop'
    'kcm_glassfort_timemachine-de.po'
)
