build() {
    cmake -B build -S "${srcdir}" \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBUILD_TESTING=ON
    cmake --build build
}

check() {
    ctest --test-dir build --output-on-failure
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm755 "${srcdir}/glassfort-restore-notify" \
        "${pkgdir}/usr/lib/glassfort-timemachine/glassfort-restore-notify"
    install -Dm644 "${srcdir}/org.glassfort.restore-notify.desktop" \
        "${pkgdir}/etc/xdg/autostart/org.glassfort.restore-notify.desktop"
}
