# glassfort-branding: the Glassfort logo (D-24), the SDDM login theme and the
# Plymouth boot splash (D-41). See README.md and docs/03-desktop-design.md.
# The logo files are generated by ./generate.

pkgname=glassfort-branding
pkgver=0.1.0
pkgrel=1
pkgdesc='Glassfort logo and branding artwork'
arch=('any')
url='https://github.com/jankln/GlassfortOS'
license=('LicenseRef-Glassfort-Trademark' 'GPL-3.0-or-later')  # logo / login theme config
# The app icon goes into the hicolor icon theme.
depends=('hicolor-icon-theme')
# The login theme uses Breeze's SDDM QML and the Glassfort wallpaper.
optdepends=(
    'plasma-desktop: Breeze SDDM theme the login screen is based on'
    'glassfort-theme: login screen background'
    'plymouth: boot splash'
)
backup=('etc/sddm.conf.d/10-glassfort.conf')
makedepends=('librsvg')
source=(
    'glassfort-symbol.svg'
    'glassfort-symbol-dark.svg'
    'glassfort-app-icon.svg'
    'glassfort-mono-dark.svg'
    'glassfort-mono-white.svg'
    'glassfort-lockup-horizontal.svg'
    'glassfort-lockup-horizontal-dark.svg'
    'glassfort-lockup-stacked.svg'
    'glassfort-lockup-stacked-dark.svg'
    'LICENSE-logo'
    'sddm-metadata.desktop'
    'sddm-theme.conf'
    'sddm-glassfort.conf'
    'plymouth-glassfort.plymouth'
    'plymouth-glassfort.script'
    'plymouth-entry.svg'
    'plymouth-dot.svg'
)
sha256sums=(
    'ce7ce5cbe6674078c8e92308bc93b2764fcba78aabb3c2d344f99cce5ae69f41'
    '9446a7e19f116819620b4262c01339bf83cadc3b7a06ecc69801cbd8966e467f'
    '4dcd27d028de0c82baf1ffb4177c4e25ddc1e54fd6ce9859e9825e51f0942491'
    '4c3b83e4ee102ec88ab261ed900cf9976d331ae1cef390247ce249eab3f928a8'
    '3d9ae14f7109d10e2c46b4685745470e10172594e3e52103cd83d6c967a64cbd'
    '20fe4f0470a2100a085f7efd184180189e3517ba024dfdb6f0b9dcef940f7aae'
    'b5ab3f634f1351b26148e1b28692477cd3ecf4d18eaedaefc5d6ab5ae5ac57db'
    '85fbac4c4b4e28619bfa7e235cb0937e9dd37baeb3a10f8a0c6ada596ed9dc76'
    '5dddc3026e639fdd18b63e2843f888c63d25e053b235df041ffb69bf635d57d3'
    'f096eb6271250bc4c91172e0a3b9a7671b2a03d1e9fd38625d865fe7603641a2'
    '68974d61e00e409ee557057599f9c31320354845e1625bcb8cd75c35a931853f'
    '1b88c4aabdc6bcaa036a9e0e5bab90c718d51429e28364e46b8e41f6d40cdad6'
    '9739adbd777384b4da57d3f7d444b37e5fe0f64268d025d7ec1775edf4d36d51'
    '51203774c61a27d1392b4861c5b3db13f254a0d629c0082086134292849aecfa'
    '6b9e0233626ea2af7767d2bc75a6de0101214357ad0622358e85d04be3e689a8'
    '85c9a95817a082857bb5ea930fbf647c0c9d40b436f66d96f771fd3a2b54b80d'
    'a5006f468a77f97ac5f030c0c4e439288738273456c75871140625386f3fa699'
