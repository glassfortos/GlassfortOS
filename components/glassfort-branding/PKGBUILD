build() {
    cd "${srcdir}"
    # Plymouth needs PNGs; the symbol is drawn for dark backgrounds.
    rsvg-convert -h 176 -o plymouth-logo.png glassfort-symbol-dark.svg
    rsvg-convert -o plymouth-entry.png plymouth-entry.svg
    rsvg-convert -o plymouth-dot.png plymouth-dot.svg
}

package() {
    cd "${srcdir}"
    install -Dm644 -t "${pkgdir}/usr/share/glassfort/branding" glassfort-*.svg
    install -Dm644 glassfort-app-icon.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/glassfort.svg"
    install -Dm644 LICENSE-logo "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

    # Login screen: Breeze's SDDM QML (plasma-desktop) with Glassfort artwork.
    local sddm="${pkgdir}/usr/share/sddm/themes/glassfort"
    install -Dm644 sddm-metadata.desktop "${sddm}/metadata.desktop"
    install -Dm644 sddm-theme.conf "${sddm}/theme.conf"
    install -Dm644 sddm-glassfort.conf "${pkgdir}/etc/sddm.conf.d/10-glassfort.conf"

    # Boot splash (D-41); glassfort-setup selects it and adds the hook.
    local ply="${pkgdir}/usr/share/plymouth/themes/glassfort"
    install -Dm644 plymouth-glassfort.plymouth "${ply}/glassfort.plymouth"
    install -Dm644 plymouth-glassfort.script "${ply}/glassfort.script"
    install -Dm644 plymouth-logo.png "${ply}/logo.png"
    install -Dm644 plymouth-entry.png "${ply}/entry.png"
    install -Dm644 plymouth-dot.png "${ply}/dot.png"
}
