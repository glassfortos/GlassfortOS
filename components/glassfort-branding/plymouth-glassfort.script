// Glassfort boot splash (D-41) for Plymouth's script plugin: the Glassfort
// symbol on Midnight, three pulsing dots, a passphrase prompt (for LUKS)
// and the last boot message at the bottom.

// Midnight #0E1222
Window.SetBackgroundTopColor(0.055, 0.071, 0.133);
Window.SetBackgroundBottomColor(0.055, 0.071, 0.133);

w = Window.GetWidth();
h = Window.GetHeight();
x0 = Window.GetX();
y0 = Window.GetY();

// --- Logo ------------------------------------------------------------------
logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(x0 + w / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(y0 + h / 2 - logo.image.GetHeight() / 2 - h / 12);
logo.sprite.SetZ(10);

// --- Progress dots -----------------------------------------------------------
dot.image = Image("dot.png");
dots_y = logo.sprite.GetY() + logo.image.GetHeight() + h / 14;
for (i = 0; i < 3; i++) {
    dots[i] = Sprite(dot.image);
    dots[i].SetX(x0 + w / 2 + (i - 1) * dot.image.GetWidth() * 2.5 - dot.image.GetWidth() / 2);
    dots[i].SetY(dots_y);
    dots[i].SetZ(10);
    dots[i].SetOpacity(0.3);
}

global.tick = 0;
global.status = "normal";

fun refresh_callback() {
    global.tick++;
    for (i = 0; i < 3; i++) {
        // A soft wave running across the three dots.
        phase = global.tick / 12 - i * 0.9;
        o = 0.25 + 0.75 * (Math.Sin(phase) + 1) / 2;
        if (global.status == "password")
            o = 0;
        dots[i].SetOpacity(o);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

// --- Passphrase prompt -----------------------------------------------------------
entry.image = Image("entry.png");
entry.sprite = Sprite(entry.image);
entry.sprite.SetX(x0 + w / 2 - entry.image.GetWidth() / 2);
entry.sprite.SetY(dots_y);
entry.sprite.SetZ(20);
entry.sprite.SetOpacity(0);

prompt.sprite = Sprite();
prompt.sprite.SetZ(20);

bullet.image = Image("dot.png").Scale(8, 8);

fun display_password_callback(text, count) {
    global.status = "password";
    prompt.image = Image.Text(text, 0.96, 0.97, 0.98, 1, "Sans 12");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(x0 + w / 2 - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(entry.sprite.GetY() - prompt.image.GetHeight() - 10);
    prompt.sprite.SetOpacity(1);
    entry.sprite.SetOpacity(1);

    max = Math.Int((entry.image.GetWidth() - 32) / 14);
    shown = count;
    if (shown > max)
        shown = max;
    for (i = 0; global.bullets[i] || i < shown; i++) {
        if (!global.bullets[i]) {
            global.bullets[i] = Sprite(bullet.image);
            global.bullets[i].SetX(entry.sprite.GetX() + 16 + i * 14);
            global.bullets[i].SetY(entry.sprite.GetY() + entry.image.GetHeight() / 2 - 4);
            global.bullets[i].SetZ(30);
        }
        if (i < shown)
            global.bullets[i].SetOpacity(1);
        else
            global.bullets[i].SetOpacity(0);
    }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
    global.status = "normal";
    entry.sprite.SetOpacity(0);
    prompt.sprite.SetOpacity(0);
    for (i = 0; global.bullets[i]; i++)
        global.bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

// --- Messages ----------------------------------------------------------------------
message.sprite = Sprite();
message.sprite.SetZ(10);

fun message_callback(text) {
    message.image = Image.Text(text, 0.55, 0.58, 0.65, 1, "Sans 10");
    message.sprite.SetImage(message.image);
    message.sprite.SetX(x0 + w / 2 - message.image.GetWidth() / 2);
    message.sprite.SetY(y0 + h - message.image.GetHeight() - h / 20);
}
Plymouth.SetMessageFunction(message_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(0);
    for (i = 0; i < 3; i++)
        dots[i].SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
