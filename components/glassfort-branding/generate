#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Generate the Glassfort logo files (D-24).

The logo is a glass fortress tower: a crown with three rounded
crenellations, a tapered tower body and one frosted front pane, coloured
Glacier Teal -> Fort Indigo (D-22). It is our own vector redraw of the
maintainer's draft, reduced to three overlapping shapes so it stays
legible at small sizes.

Only SVG features that Qt's SVG renderer supports are used (no masks,
filters or CSS), because KDE renders icons with QtSvg.

Writes, next to this script:
  glassfort-symbol.svg               full-colour symbol, light backgrounds
  glassfort-symbol-dark.svg          full-colour symbol, dark backgrounds
  glassfort-app-icon.svg             app icon (Midnight squircle)
  glassfort-mono-dark.svg            flat symbol in Midnight (16-32 px)
  glassfort-mono-white.svg           flat symbol in white (16-32 px)
  glassfort-lockup-horizontal{,-dark}.svg
  glassfort-lockup-stacked{,-dark}.svg

Usage:
  generate                         write the files
  generate --check                 fail if the committed files are stale
  generate --wordmark-font FILE    re-extract the wordmark outlines from
                                   InterVariable.ttf (needs fonttools and
                                   uharfbuzz), then write the files
"""

from __future__ import annotations

import argparse
import math
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
WORDMARK = HERE / "wordmark-inter-semibold.txt"

TEAL = "#3DD6C6"
INDIGO = "#4C4FE0"
MIDNIGHT = "#0E1222"
FROST = "#F5F7FA"

Point = tuple[float, float]

# Geometry on a 256 x 256 grid.
CROWN: list[tuple[Point, float]] = [
    ((46, 36), 10),
    ((90, 36), 10),
    ((90, 64), 6),
    ((106, 64), 6),
    ((106, 36), 10),
    ((150, 36), 10),
    ((150, 64), 6),
    ((166, 64), 6),
    ((166, 36), 10),
    ((210, 36), 10),
    ((210, 104), 10),
    ((46, 104), 10),
]
BODY = [((62, 92), 10), ((194, 92), 10), ((206, 222), 12), ((50, 222), 12)]
# Where the body overlaps the crown: drawn lighter, like stacked glass.
OVERLAP = [((62, 92), 10), ((194, 92), 10), ((195.15, 104), 0), ((60.85, 104), 0)]
PANE = [((110, 98), 7), ((146, 98), 7), ((158, 214), 9), ((98, 214), 9)]
# The flat variant starts the pane below the crown so it reads as a cut-out.
PANE_FLAT = [((112, 112), 6), ((144, 112), 6), ((156, 212), 8), ((100, 212), 8)]

HEADER = (
    "<!-- Glassfort logo. Not covered by the project licences; see TRADEMARKS.md. -->\n"
    "<!-- Generated by components/glassfort-branding/generate. Do not edit. -->\n"
)


def n(v: float) -> str:
    s = f"{v:.2f}".rstrip("0").rstrip(".")
    return "0" if s == "-0" else s


def rounded(poly: list[tuple[Point, float]]) -> str:
    """Closed path through the polygon with each corner rounded by its radius."""
    pts = [p for p, _ in poly]
    out = []
    count = len(pts)
    for i, (p, r) in enumerate(poly):
        prev = pts[i - 1]
        nxt = pts[(i + 1) % count]

        def towards(a: Point, b: Point, d: float) -> Point:
            length = math.dist(a, b)
            t = min(d, length / 2) / length
            return (a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t)

        a = towards(p, prev, r)
        b = towards(p, nxt, r)
        cmd = "M" if i == 0 else "L"
        # Cubic with control points at 55 % towards the corner: close to a
        # circular arc for right angles, smooth for the tapered corners.
        c1 = (a[0] + (p[0] - a[0]) * 0.55, a[1] + (p[1] - a[1]) * 0.55)
        c2 = (b[0] + (p[0] - b[0]) * 0.55, b[1] + (p[1] - b[1]) * 0.55)
        out.append(
            f"{cmd}{n(a[0])},{n(a[1])}C{n(c1[0])},{n(c1[1])} {n(c2[0])},{n(c2[1])} {n(b[0])},{n(b[1])}"
        )
    return "".join(out) + "Z"


def svg(width: float, height: float, body: str, defs: str = "") -> str:
    return (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        + HEADER
        + f'<svg xmlns="http://www.w3.org/2000/svg" version="1.1" width="{n(width)}" height="{n(height)}" '
        f'viewBox="0 0 {n(width)} {n(height)}">\n'
        + (f"<defs>{defs}</defs>\n" if defs else "")
        + body
        + "\n</svg>\n"
    )


def gradients(prefix: str) -> str:
    return (
        f'<linearGradient id="{prefix}crown" gradientUnits="userSpaceOnUse" x1="46" y1="40" x2="210" y2="100">'
        f'<stop offset="0" stop-color="{TEAL}"/><stop offset="1" stop-color="{INDIGO}"/></linearGradient>'
        f'<linearGradient id="{prefix}body" gradientUnits="userSpaceOnUse" x1="70" y1="92" x2="190" y2="226">'
        f'<stop offset="0" stop-color="{TEAL}"/><stop offset="1" stop-color="{INDIGO}"/></linearGradient>'
        f'<linearGradient id="{prefix}frost" gradientUnits="userSpaceOnUse" x1="0" y1="92" x2="0" y2="170">'
        '<stop offset="0" stop-color="#FFFFFF" stop-opacity="0.18"/>'
        '<stop offset="1" stop-color="#FFFFFF" stop-opacity="0"/></linearGradient>'
        f'<linearGradient id="{prefix}pane" gradientUnits="userSpaceOnUse" x1="0" y1="98" x2="0" y2="214">'
        '<stop offset="0" stop-color="#FFFFFF" stop-opacity="0.34"/>'
        '<stop offset="1" stop-color="#FFFFFF" stop-opacity="0.12"/></linearGradient>'
    )


def symbol_shapes(prefix: str, dark: bool) -> str:
    """The full-colour symbol on the 256 grid."""
    edge = '<path d="{d}" fill="none" stroke="#FFFFFF" stroke-opacity="{o}" stroke-width="1.5"/>'
    crown, body, pane = rounded(CROWN), rounded(BODY), rounded(PANE)
    parts = [
        f'<path d="{crown}" fill="url(#{prefix}crown)"/>',
        f'<path d="{body}" fill="url(#{prefix}body)"/>',
        f'<path d="{body}" fill="url(#{prefix}frost)"/>',
        f'<path d="{rounded(OVERLAP)}" fill="#FFFFFF" fill-opacity="0.22"/>',
        f'<path d="{pane}" fill="url(#{prefix}pane)"/>',
        edge.format(d=pane, o="0.55"),
    ]
    if dark:
        parts.insert(1, edge.format(d=crown, o="0.22"))
        parts.insert(3, edge.format(d=body, o="0.22"))
    return "".join(parts)


def flat_shapes(color: str) -> str:
    # Body with the pane as an even-odd hole; the crown is drawn on top.
    return (
        f'<path d="{rounded(BODY)}{rounded(PANE_FLAT)}" fill="{color}" fill-rule="evenodd"/>'
        f'<path d="{rounded(CROWN)}" fill="{color}"/>'
    )


def symbol(dark: bool) -> str:
    return svg(256, 256, symbol_shapes("g", dark), gradients("g"))


def app_icon() -> str:
    r = 58
    body = (
        f'<rect x="8" y="8" width="240" height="240" rx="{r}" fill="url(#bg)"/>'
        f'<rect x="8.75" y="8.75" width="238.5" height="238.5" rx="{r - 0.75}" fill="none" '
        'stroke="#FFFFFF" stroke-opacity="0.10" stroke-width="1.5"/>'
        # Symbol at 0.78, centred: its height (145) is 60 % of the squircle.
        '<g transform="translate(28.16,27.38) scale(0.78)">'
        + symbol_shapes("g", True)
        + "</g>"
    )
    defs = (
        '<linearGradient id="bg" gradientUnits="userSpaceOnUse" x1="0" y1="8" x2="0" y2="248">'
        f'<stop offset="0" stop-color="#1A2140"/><stop offset="1" stop-color="{MIDNIGHT}"/></linearGradient>'
        + gradients("g")
    )
    return svg(256, 256, body, defs)


def mono(color: str) -> str:
    return svg(256, 256, flat_shapes(color))


def load_wordmark() -> tuple[float, str]:
    advance, path = 0.0, ""
    for line in WORDMARK.read_text(encoding="utf-8").splitlines():
        if line.startswith("advance "):
            advance = float(line.split()[1])
        elif line.startswith("path "):
            path = line[5:]
    return advance, path


def lockup(stacked: bool, dark: bool) -> str:
    advance, path = load_wordmark()
    text_color = FROST if dark else MIDNIGHT
    cap = 1490  # Inter cap height in font units
    sym = symbol_shapes("g", dark)
    # The symbol occupies y 36..222 on its grid (186 units).
    if not stacked:
        h = 186.0
        k = (h * 0.42) / cap  # cap height = 42 % of the symbol height
        text_w = advance * k
        gap = 40.0
        width = 164 + gap + text_w + 2 * 16
        height = h + 2 * 16
        baseline = 16 + h / 2 + (cap * k) / 2
        body = (
            f'<g transform="translate({n(16 - 46)},{n(16 - 36)})">{sym}</g>'
            f'<path transform="translate({n(16 + 164 + gap)},{n(baseline)}) scale({k:.5f})" '
            f'd="{path}" fill="{text_color}"/>'
        )
    else:
        k = 64.0 / cap  # cap height 64 units
        text_w = advance * k
        width = max(164.0, text_w) + 2 * 24
        height = 186 + 40 + 64 + 2 * 24 + 8
        sx = (width - 164) / 2
        baseline = 24 + 186 + 40 + 64
        body = (
            f'<g transform="translate({n(sx - 46)},{n(24 - 36)})">{sym}</g>'
            f'<path transform="translate({n((width - text_w) / 2)},{n(baseline)}) scale({k:.5f})" '
            f'd="{path}" fill="{text_color}"/>'
        )
    return svg(width, height, body, gradients("g"))


def outputs() -> dict[Path, str]:
    return {
        HERE / "glassfort-symbol.svg": symbol(False),
        HERE / "glassfort-symbol-dark.svg": symbol(True),
        HERE / "glassfort-app-icon.svg": app_icon(),
        HERE / "glassfort-mono-dark.svg": mono(MIDNIGHT),
        HERE / "glassfort-mono-white.svg": mono("#FFFFFF"),
        HERE / "glassfort-lockup-horizontal.svg": lockup(False, False),
        HERE / "glassfort-lockup-horizontal-dark.svg": lockup(False, True),
        HERE / "glassfort-lockup-stacked.svg": lockup(True, False),
        HERE / "glassfort-lockup-stacked-dark.svg": lockup(True, True),
    }


def extract_wordmark(font: Path) -> None:
    import io

    import uharfbuzz as hb
    from fontTools.pens.svgPathPen import SVGPathPen
    from fontTools.pens.transformPen import TransformPen
    from fontTools.ttLib import TTFont
    from fontTools.varLib.instancer import instantiateVariableFont

    inst = instantiateVariableFont(TTFont(font), {"wght": 600, "opsz": 32})
    buf = io.BytesIO()
    inst.save(buf)
    hbfont = hb.Font(hb.Face(buf.getvalue()))
    b = hb.Buffer()
    b.add_str("Glassfort")
    b.guess_segment_properties()
    hb.shape(hbfont, b, {"kern": True, "liga": True})
    glyphs, order = inst.getGlyphSet(), inst.getGlyphOrder()
    pen = SVGPathPen(glyphs, ntos=lambda v: f"{v:.1f}".rstrip("0").rstrip("."))
    x = 0
    for info, pos in zip(b.glyph_infos, b.glyph_positions):
        glyphs[order[info.codepoint]].draw(
            TransformPen(pen, (1, 0, 0, -1, x + pos.x_offset, -pos.y_offset))
        )
        x += pos.x_advance
    header = [
        ln
        for ln in WORDMARK.read_text(encoding="utf-8").splitlines()
        if ln.startswith("#")
    ]
    WORDMARK.write_text(
        "\n".join([*header, f"advance {x}", f"path {pen.getCommands()}"]) + "\n",
        encoding="utf-8",
    )


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--check", action="store_true", help="verify instead of writing")
    ap.add_argument(
        "--wordmark-font",
        type=Path,
        help="InterVariable.ttf to re-extract the wordmark from",
    )
    args = ap.parse_args()
    if args.wordmark_font:
        extract_wordmark(args.wordmark_font)
    errors = []
    for path, content in outputs().items():
        if args.check:
            if not path.exists() or path.read_text(encoding="utf-8") != content:
                errors.append(f"{path.name} is out of date; run {Path(__file__).name}")
        else:
            path.write_text(content, encoding="utf-8")
    for e in errors:
        print(f"error: {e}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
