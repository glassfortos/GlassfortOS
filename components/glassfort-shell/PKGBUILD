# glassfort-shell: Glassfort's own Plasma widgets (D-36): start menu, later
# dock and control center. See README.md and docs/03-desktop-design.md.
#
# makepkg takes local sources only as flat files, so the plasmoid files
# carry a prefix (startmenu-*) or a unique type name (StartMenu*.qml) and
# package() puts them into the plasmoid layout.

pkgname=glassfort-shell
pkgver=0.1.0
pkgrel=1
pkgdesc='Glassfort start menu, dock and control center for Plasma'
arch=('any')
url='https://github.com/jankln/GlassfortOS'
license=('GPL-3.0-or-later')
# plasma-workspace: Kicker models (org.kde.plasma.private.kicker);
# kirigami-addons: avatar; glassfort-branding: the "glassfort" start icon.
depends=(
    'glassfort-branding'
    'kirigami-addons'
    'kcoreaddons'
    'plasma-workspace'
    'qt6-declarative'
)
source=(
    'startmenu-metadata.json'
    'startmenu-main.xml'
    'startmenu-main.qml'
    'StartMenuButton.qml'
    'StartMenuPopup.qml'
    'StartMenuRow.qml'
    'StartMenuTile.qml'
    'StartMenuPinMenu.qml'
)
sha256sums=(
    '20a08734f94f54d1a2cf941f85c3416b9580c5160114f26faf6ce5de886700da'
    '59b83aa356bd31b0ca37e6a2bd1c3de828c6f5b33c86fdf4070272ee5055ead8'
    '6ae5eec65a9bd9cf8acd470f1362f4524df1b2a843a3fa2ce40e301ef2ddaa1d'
    '34984d8c0fad1552a2c4a022a242705f8cf7e3f1bad44f4db8cca449145a751e'
    '05820e9ba5ae3db2d600ba6b15d30d0b94a7fa25a1fc45a29fadebcc334cabc8'
    '63195ac178a5eeaf67ea43c79b81c62726c5dea26b877764b347936adedf0eac'
    '5f5609d56805b4bf70d0570d7b4882b17ad3f9f67d0a6044aae334cbd02ffe1f'
    '92c175ffd09bbf4de30ab858710f1032d10b3fa07fa473e99caec686a4b4b519'
