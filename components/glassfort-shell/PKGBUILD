# glassfort-shell: Glassfort's own Plasma widgets (D-36): start menu, dock
# and control center. See README.md and docs/03-desktop-design.md.
#
# makepkg takes local sources only as flat files, so the plasmoid files
# carry a prefix (startmenu-*) or a unique type name (StartMenu*.qml) and
# package() puts them into the plasmoid layout.

pkgname=glassfort-shell
pkgver=0.1.0
pkgrel=1
pkgdesc='Glassfort start menu, dock and control center for Plasma'
arch=('any')
url='https://github.com/jankln/GlassfortOS'
license=('GPL-3.0-or-later')
# plasma-workspace: Kicker models (org.kde.plasma.private.kicker) and the
# task model (org.kde.taskmanager);
# kpipewire: window previews; kirigami-addons: avatar; plasma-nm, bluez-qt,
# plasma-pa, powerdevil: control center backends; spectacle: screen
# recording; glassfort-branding: the "glassfort" start icon.
depends=(
