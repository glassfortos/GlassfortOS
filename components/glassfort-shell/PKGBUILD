# Install a plasmoid: $1 = id, $2 = file prefix, then the QML type files.
_install_plasmoid() {
    local dir="${pkgdir}/usr/share/plasma/plasmoids/$1" prefix=$2 f
    shift 2
    install -Dm644 "${prefix}-metadata.json" "${dir}/metadata.json"
    install -Dm644 "${prefix}-main.xml" "${dir}/contents/config/main.xml"
    install -Dm644 "${prefix}-main.qml" "${dir}/contents/ui/main.qml"
    for f in "$@"; do
        install -Dm644 "${f}" "${dir}/contents/ui/${f}"
    done
}

package() {
    cd "${srcdir}"
    _install_plasmoid org.glassfort.startmenu startmenu \
        StartMenuButton.qml StartMenuPopup.qml StartMenuRow.qml StartMenuTile.qml StartMenuPinMenu.qml
    _install_plasmoid org.glassfort.dock dock DockTask.qml DockPreview.qml
    _install_plasmoid org.glassfort.controlcenter controlcenter \
        ControlCenterButton.qml ControlCenterPopup.qml ControlCenterSlider.qml ControlCenterTile.qml

    # Default panel layout of both Glassfort global themes (glassfort-theme).
    local lnf
    for lnf in org.glassfort.desktop org.glassfort.dark.desktop; do
        install -Dm644 layout.js \
            "${pkgdir}/usr/share/plasma/look-and-feel/${lnf}/contents/layouts/org.kde.plasma.desktop-layout.js"
    done
}
