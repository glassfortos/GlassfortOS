# remove from airootfs!
# SPDX-License-Identifier: GPL-3.0-or-later
# From archiso's releng profile: the live system needs working mirrors
# (archinstall syncs the databases before it applies its own mirror
# settings). Arch's geo-routed mirror first, then all HTTPS mirrors.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Description = Enabling HTTPS mirrors in /etc/pacman.d/mirrorlist...
When = PostTransaction
Depends = pacman-mirrorlist
Depends = sed
Exec = /usr/bin/sed -E -i -e 's/#(Server = https:)/\1/g' -e '1i Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch' /etc/pacman.d/mirrorlist
