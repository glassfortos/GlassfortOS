# Glassfort desktop: scripts/build-iso replaces the next line with the
# dependencies of glassfort-desktop *without* glassfort-settings. The live
# system has no Btrfs, ESP or Limine; glassfort-settings' Limine and snapper
# hooks would fail there. Installed systems get the full glassfort-desktop.
@GLASSFORT_DESKTOP@
# Installer
glassfort-installer
# Live system
base
linux
linux-firmware
linux-firmware-marvell
sof-firmware
intel-ucode
amd-ucode
mkinitcpio
mkinitcpio-archiso
sudo
# Installer backend and disk tools (glassfort-installer uses archinstall)
archinstall
arch-install-scripts
btrfs-progs
cryptsetup
dosfstools
e2fsprogs
exfatprogs
ntfs-3g
gptfdisk
parted
efibootmgr
limine
# Virtual machines (testing, trying Glassfort in a VM)
qemu-guest-agent
spice-vdagent
open-vm-tools
virtualbox-guest-utils
